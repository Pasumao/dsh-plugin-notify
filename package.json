{
  "name": "dsh-notify",
  "description": "Native Windows toast notifications for DeepSeek Harness (dsh), with a Windows-focused system prompt section. Pops the moment the agent stops running — finished / aborted / error / output limit / waiting for your choice / session closed — body labeled with workspace · session, so you can switch windows during long tasks and catch the toast instead of watching a spinner. Pure host-side, zero dependencies, zero build.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-notice.ps1",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "notify",
    "notification",
    "toast",
    "windows-toast",
    "windows",
    "long-running",
    "agent-monitor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pasumao/dsh-plugin-notify.git"
  },
  "homepage": "https://github.com/Pasumao/dsh-plugin-notify#readme",
  "bugs": {
    "url": "https://github.com/Pasumao/dsh-plugin-notify/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
